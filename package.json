{
  "name": "ofertas-cuba",
  "private": true,
  "version": "0.1.0",
  "description": "Comparador comunitario de compra y venta en Cuba (PalmApps)",
  "scripts": {
    "dev": "pnpm --filter @ofertas-cuba/web dev",
    "dev:bot": "pnpm --filter @ofertas-cuba/bot dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @ofertas-cuba/shared test",
    "scrape:facebook": "pnpm --filter @ofertas-cuba/scraper scrape:facebook",
    "scrape:telegram": "pnpm --filter @ofertas-cuba/scraper scrape:telegram",
    "discover:groups": "pnpm --filter @ofertas-cuba/scraper discover",
    "db:push": "pnpm --filter @ofertas-cuba/db db:push",
    "db:seed": "pnpm --filter @ofertas-cuba/db db:seed",
    "bot:webhook:set": "pnpm --filter @ofertas-cuba/bot exec tsx ../../scripts/set-bot-webhook.ts",
    "secrets:sync": "node scripts/sync-github-secrets.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
